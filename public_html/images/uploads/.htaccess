# Uploaded files are data, never programs.
Options -ExecCGI -Indexes

<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php6 .php7 .php8 .phar .cgi .pl .py .sh
    RemoveType .php .phtml .phar
</IfModule>

<FilesMatch "(?i)\.(php\d?|phtml|phar|pl|py|cgi|sh|shtml|htaccess)$">
    Require all denied
</FilesMatch>
